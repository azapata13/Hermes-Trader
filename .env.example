# Hermès D1 Slack HUMAN_APPROVAL — copy to a local .env if you use one.
# Never commit real tokens.

SLACK_BOT_TOKEN=xoxb-replace-me
SLACK_APP_TOKEN=xapp-replace-me
HERMES_SLACK_CHANNEL_ID=C_REPLACE_ME

# Optional:
# HERMES_SLACK_JOURNAL=~/hermes-data/human_approvals.jsonl
# D2.8 approver allowlist: comma-separated Slack user IDs (U…/W…) allowed to act on proposals.
# Unset = ENTER is recorded as intent only and flagged approver_allowlist_missing (never executable).
# HERMES_SLACK_APPROVER_IDS=U_REPLACE_ME
